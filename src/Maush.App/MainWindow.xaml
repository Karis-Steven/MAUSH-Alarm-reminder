<Window x:Class="Maush.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MAUSH Alarm Reminder 1.0" Height="760" Width="560" MinHeight="680" MinWidth="500"
        WindowStartupLocation="CenterScreen" Background="#F4F2ED">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#E4E0D7" />
            <Setter Property="Foreground" Value="#262521" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#CBC5B9" />
            <Setter Property="Background" Value="#FFFEFB" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderBrush" Value="#D8D3C9" />
            <Setter Property="Background" Value="#FAF9F6" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Border Background="{Binding StatusBackground}" CornerRadius="14" Padding="24" Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="#CFE8E2" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding RemainingText}" Foreground="White" FontSize="58" FontWeight="SemiBold"
                               FontFamily="Consolas" Margin="0,10,0,6" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding NextStepText}" Foreground="#D9E2EC" FontSize="14" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,8">
                <Button Content="开始" Command="{Binding StartCommand}" Background="#2F855A" Foreground="White" />
                <Button Content="{Binding PauseResumeText}" Command="{Binding PauseResumeCommand}" />
                <Button Content="停止" Command="{Binding StopCommand}" Background="#C05640" Foreground="White" />
                <Button Content="重置" Command="{Binding ResetCommand}" />
            </UniformGrid>

            <Border Background="#FFF4D6" CornerRadius="6" Padding="10" Margin="0,3"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding NoticeMessage}" Foreground="#7A5B12" TextWrapping="Wrap" />
            </Border>
            <Border Background="#FDE8E7" CornerRadius="6" Padding="10" Margin="0,3"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#9B2C2C" TextWrapping="Wrap" />
            </Border>

            <GroupBox Header="计划设置">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="工作时长" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="72" Text="{Binding WorkMinutes, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="分钟" VerticalAlignment="Center" Margin="8,0" />
                        <Button Content="30" Click="SetWorkPreset_Click" Tag="30" />
                        <Button Content="45" Click="SetWorkPreset_Click" Tag="45" />
                        <Button Content="60" Click="SetWorkPreset_Click" Tag="60" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="休息时长" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Width="72" Text="{Binding RestMinutes, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Text="分钟" VerticalAlignment="Center" Margin="8,0" />
                        <Button Content="5" Click="SetRestPreset_Click" Tag="5" />
                        <Button Content="10" Click="SetRestPreset_Click" Tag="10" />
                        <Button Content="15" Click="SetRestPreset_Click" Tag="15" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="循环模式" VerticalAlignment="Center" Margin="0,14,0,0" />
                    <CheckBox Grid.Row="2" Grid.Column="1" Content="持续循环，直到手动停止"
                              IsChecked="{Binding IsLoopEnabled}" Margin="0,14,0,0" VerticalAlignment="Center" />
                </Grid>
            </GroupBox>

            <GroupBox Header="提醒声音">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="该休息了" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding RestAudioName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="选择" Click="SelectRestAudio_Click" />
                    <Button Grid.Column="3" Content="{Binding PreviewButtonText}" Click="PreviewRestAudio_Click" />
                    <TextBlock Grid.Row="1" Text="继续工作" VerticalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResumeAudioName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                    <Button Grid.Row="1" Grid.Column="2" Content="选择" Click="SelectResumeAudio_Click" Margin="4,12,4,4" />
                    <Button Grid.Row="1" Grid.Column="3" Content="{Binding PreviewButtonText}" Click="PreviewResumeAudio_Click" Margin="4,12,4,4" />
                </Grid>
            </GroupBox>

            <GroupBox Header="本地数据">
                <StackPanel Orientation="Horizontal">
                    <Button Content="导出备份" Click="ExportBackup_Click" />
                    <Button Content="从备份恢复" Click="RestoreBackup_Click" />
                    <TextBlock Text="备份包含设置与提醒音" Foreground="#6B675F" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
